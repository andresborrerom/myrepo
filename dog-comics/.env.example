# Copia este archivo a  dog-comics/.env  y pega tus keys reales.
# El archivo .env real está gitignored: NUNCA se sube al repo.
#
# Para el Paso 3 (voces) solo necesitas esta:
# OJO: en el environment de Claude Code el secreto ya viene cargado con el nombre
# ELEVENLABS_LABS_KEY, y el robot también lo acepta — ahí no necesitas este archivo.
# Este .env es solo para correr en tu propio computador.
ELEVEN_API_KEY=pega_aqui_tu_key_de_elevenlabs

# Para el Paso 4/5 (imágenes con Gemini "Nano Banana"):
# En el environment va como secreto GEMINI_API_KEY. Requiere facturación activada.
GEMINI_API_KEY=pega_aqui_tu_key_de_google_ai_studio

# Para el Paso 6 (video con fal.ai / Hailuo). En el environment va como secreto FAL_KEY.
FAL_KEY=pega_aqui_tu_key_de_fal_ai
