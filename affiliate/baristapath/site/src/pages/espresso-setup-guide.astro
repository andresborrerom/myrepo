---
// Landing page — lead magnet PDF "How to Choose Your First Home Espresso Setup".
//
// Estructura:
//   1. Hero: title + value prop + mock PDF preview (CSS-only "book cover").
//   2. What's inside: 3-bullet list de contenido del PDF.
//   3. Email signup (variant=landing).
//   4. Sample chapter preview: 2-3 bullets verbatim del PDF.
//   5. About the author + methodology link.
//
// Schema: WebPage + ItemList (los 3 main bullets como ToC).
//
// Anti-gray-hat (CLAUDE.md):
//   - "12 pages" en headline = number real, no marketing inflation.
//   - "Free, no payment" disclosure visible.
//   - El email signup ya tiene fallback que entrega el PDF aunque la
//     suscripción falle — el lead recibe valor sí o sí.

import Base from '../layouts/Base.astro';
import EmailSignup from '../components/EmailSignup.astro';

const siteUrl = 'https://baristapath.com';
const pageUrl = `${siteUrl}/espresso-setup-guide/`;
const pdfUrl = '/lead-magnets/espresso-setup-guide.pdf';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'How to Choose Your First Home Espresso Setup — Free PDF Guide',
  url: pageUrl,
  description:
    'Free 12-page PDF guide covering budget tiers, espresso machine selection criteria, grinder choice, accessories, common mistakes, and a 10-term glossary.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Barista Path',
    url: `${siteUrl}/`,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    contentUrl: `${siteUrl}/app-icon.png`,
  },
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "What's inside the guide",
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Budget tiers with realistic total-cost breakdowns',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Machine and grinder selection criteria, with the specs that actually matter',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Common beginner mistakes and how to avoid them',
    },
  ],
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Free guide', url: '/espresso-setup-guide/' },
];
---
<Base
  title="Free Guide: How to Choose Your First Home Espresso Setup — Barista Path"
  description="Free 12-page PDF guide. Budget tiers, espresso machine and grinder selection criteria, accessories, common mistakes. No fluff, no upsell."
  breadcrumbs={breadcrumbs}
  jsonLd={[webPageSchema, itemListSchema]}
  showByline={false}
>
  <section class="lead-magnet-hero">
    <div class="lead-magnet-hero__grid">
      <div class="lead-magnet-hero__copy">
        <p class="lead-magnet-hero__eyebrow">FREE 12-PAGE PDF</p>
        <h1 class="lead-magnet-hero__title">
          How to choose your first home espresso setup
        </h1>
        <p class="lead-magnet-hero__lead">
          The decision framework we wish someone had handed us before we spent
          $1,400 on the wrong machine and grinder. Budget tiers, the five specs
          that matter, and the mistakes that cost beginners the most money.
        </p>
        <ul class="lead-magnet-hero__bullets">
          <li><strong>Budget tiers</strong> with realistic total-cost breakdowns from $400 to $2,000+.</li>
          <li><strong>Machine and grinder selection criteria</strong> — boiler types, burr geometry, what to ignore.</li>
          <li><strong>Common mistakes</strong> and a 10-term glossary so you can decode any review.</li>
        </ul>
      </div>
      <aside class="lead-magnet-hero__cover" aria-hidden="true">
        {/* Mock PDF cover — CSS-only book/PDF preview. */}
        <div class="pdf-mock">
          <div class="pdf-mock__top">FREE GUIDE</div>
          <div class="pdf-mock__title">How to Choose Your First Home Espresso Setup</div>
          <div class="pdf-mock__rule"></div>
          <div class="pdf-mock__subtitle">Budget tiers · Machine criteria · Grinder selection · Mistakes to avoid</div>
          <div class="pdf-mock__bottom">
            <span class="pdf-mock__bottom-pages">12 pages</span>
            <span class="pdf-mock__bottom-brand">baristapath.com</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <EmailSignup
    variant="landing"
    headline="Send me the free guide"
    promise="Enter your email below. We'll deliver the PDF instantly and add you to a short, monthly editorial newsletter — 1–2 emails per month, never spam."
    cta="Send me the PDF"
    source="landing-espresso-setup-guide"
  />

  <section class="section lead-magnet-preview">
    <h2>What's inside (sample)</h2>
    <p class="muted">
      A real excerpt from page 3 of the guide — the "how to pick your tier" section:
    </p>
    <blockquote class="lead-magnet-preview__quote">
      <p>
        <strong>The single most common beginner mistake</strong> is spending 90% of the
        budget on the machine and 10% on the grinder. A $1,500 machine with a $50 blade
        grinder will produce worse espresso than a $500 machine with a $300 burr grinder.
        Allocate at least 30–40% of total budget to the grinder.
      </p>
    </blockquote>
    <p>
      The full guide gives you a tier-by-tier matching table (Budget through Pro),
      a "skip if" callout at the end of every section so you know when the advice does
      <em>not</em> apply to you, and total-cost worked examples so you don't get
      surprised by the $200 of accessories nobody mentioned in the review you read.
    </p>
  </section>

  <section class="section lead-magnet-who">
    <h2>Who wrote it</h2>
    <p>
      The same single editor who writes every product page on baristapath.com — a
      Colombian data scientist relocated abroad with a long-running interest in home
      espresso. No team of "experts", no AI-generated filler. If you reply to any
      email we send, the person answering is the person who wrote the guide.
      Methodology in full at <a href="/methodology/">/methodology</a>.
    </p>
    <p class="muted lead-magnet-who__small">
      The guide is free. The site is funded by Amazon affiliate links — we earn a
      small commission when you buy through them, at no extra cost to you. The
      product recommendations in the guide are the same ones we publish openly on
      the site. We never accept payment for placement or rankings.
    </p>
  </section>

  <section class="section lead-magnet-explore">
    <h2>Prefer to browse the site?</h2>
    <p>If you would rather skim than read a PDF, these pages cover similar ground:</p>
    <ul>
      <li><a href="/quiz/which-espresso-machine/">Which espresso machine should I buy? (7-question quiz, no email gate)</a></li>
      <li><a href="/tools/cost-per-cup-calculator/">Cost-per-cup &amp; payback calculator</a></li>
      <li><a href="/best/best-espresso-machine-under-500/">Best espresso machines under $500</a></li>
      <li><a href="/best/best-grinder-under-200/">Best grinders under $200</a></li>
      <li><a href="/methodology/">How we review coffee equipment</a></li>
    </ul>
  </section>

  <p class="lead-magnet-direct-download muted">
    Already trust us with your email? You can also
    <a href={pdfUrl} download>download the PDF directly here</a> — but the
    email list is where we share updates when we re-test recommendations.
  </p>
</Base>

<style>
  .lead-magnet-hero {
    margin: var(--space-xl) 0;
  }

  .lead-magnet-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 820px) {
    .lead-magnet-hero__grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .lead-magnet-hero__eyebrow {
    margin: 0 0 var(--space-sm);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--color-link);
    font-weight: 700;
  }

  .lead-magnet-hero__title {
    margin: 0 0 var(--space-md);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.15;
  }

  .lead-magnet-hero__lead {
    margin: 0 0 var(--space-lg);
    font-size: 1.1rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .lead-magnet-hero__bullets {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.55;
  }

  .lead-magnet-hero__bullets li {
    margin-bottom: var(--space-sm);
  }

  /* ---- Mock PDF cover (CSS-only) ---- */
  .lead-magnet-hero__cover {
    display: flex;
    justify-content: center;
  }

  .pdf-mock {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1 / 1.414;
    background: linear-gradient(180deg, #fffaf3 0%, #f6e8d3 100%);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.35),
      0 2px 6px rgba(0, 0, 0, 0.08);
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    color: #3a2f24;
    font-family: var(--font-serif);
    position: relative;
  }

  .pdf-mock__top {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: #8a4b1a;
    font-weight: 700;
    text-align: center;
  }

  .pdf-mock__title {
    margin-top: auto;
    font-size: 1.4rem;
    line-height: 1.2;
    font-weight: 700;
    text-align: center;
  }

  .pdf-mock__rule {
    width: 40px;
    height: 2px;
    background: #8a4b1a;
    margin: 12px auto;
  }

  .pdf-mock__subtitle {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.4;
    color: #5c554c;
    text-align: center;
    margin-bottom: auto;
  }

  .pdf-mock__bottom {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: #8a4b1a;
    letter-spacing: 0.05em;
    margin-top: 12px;
  }

  /* ---- Preview / supporting sections ---- */
  .lead-magnet-preview__quote {
    margin: var(--space-md) 0;
    padding: var(--space-md) var(--space-lg);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface-alt);
    border-radius: var(--radius);
  }

  .lead-magnet-preview__quote p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .lead-magnet-who__small {
    font-size: 0.85rem;
  }

  .lead-magnet-explore ul {
    padding-left: 1.25rem;
    line-height: 1.7;
  }

  .lead-magnet-direct-download {
    margin: var(--space-xl) 0;
    font-size: 0.9rem;
    text-align: center;
  }
</style>
