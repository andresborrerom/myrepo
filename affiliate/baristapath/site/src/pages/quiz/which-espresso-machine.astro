---
// Quiz interactivo "Which espresso machine should I buy?"
//
// Diferenciador editorial: ningún afiliado puro de coffee equipment
// publica un quiz HONESTO. Si el budget es muy bajo, recomendamos
// Moka pot / AeroPress en vez de fingir que un machine de $139 hace
// espresso "real". Si beginner + máquina pro, advertimos del ROI
// emocional. Esa franqueza es el diferenciador.
//
// Pattern: igual que /tools/cost-per-cup-calculator/ — vanilla JS,
// schema markup, mobile-responsive. Cero frameworks. Catalog
// serializado JSON inline en build time.
//
// Anti-gray-hat (CLAUDE.md):
// - No empujar machine si combinación pide path alternativo
// - Caveats explícitos cuando el quiz detecta inconsistencia
// - Recomendaciones top 3 con score-based ranking transparente

import Base from '../../layouts/Base.astro';
import { catalogWithReviews } from '../../data/quiz-catalog.js';
// Vite ?raw import: cargamos el source de quiz-scoring.js como string al
// build-time para inyectarlo en el inline script del browser. Misma lógica
// que corre en los tests de Node, sin duplicación.
import scoringSourceRaw from '../../lib/quiz-scoring.js?raw';

// El catálogo + la lógica de scoring viven en módulos extraídos:
//   src/data/quiz-catalog.js  → 27 entries (máquinas + brewers de fallback)
//   src/lib/quiz-scoring.js   → scoreProduct, buildCaveats, buildSkipCategories,
//                                pickRecommendations
// Tests en test/quiz.spec.js consumen ambos via ES module imports.
//
// El JS inline del browser usa el MISMO archivo de scoring: lo leemos
// como string en build-time, stripeamos los `export` keywords e inyectamos
// dentro del IIFE de abajo. Así no duplicamos la lógica entre Node y browser.
// Si tuneás pesos en quiz-scoring.js, el inline script se actualiza al build.


const faqs = [
  {
    q: 'How does the quiz pick a recommendation?',
    a: 'The quiz scores every espresso machine in our catalog against your seven answers using a transparent point system. Each answer adds or subtracts points for each candidate. The top scorer becomes the headline pick; the next two become alternates. If no candidate scores above zero, you see a caveat instead of a recommendation — that means your answers are pointing at a path other than buying a machine right now.',
  },
  {
    q: 'Why does the quiz sometimes tell me to buy a Moka pot or AeroPress instead of an espresso machine?',
    a: 'Because honesty pays better than a single affiliate click. Under roughly $200, no "espresso machine" pulls real 9-bar shots — pressurized baskets compensate cosmetically but the result is closer to strong coffee than espresso. A Moka pot or AeroPress at $40 produces a more honest beverage in that budget. We would rather lose a sale than route you toward a disappointing first machine.',
  },
  {
    q: 'Does the quiz favor cheaper machines so I am more likely to buy?',
    a: 'No. The scoring favors fit, not price. If you answered "advanced barista, dedicated coffee corner, mostly straight espresso, full manual control" the quiz will hand you a Cafelat Robot or a prosumer dual boiler, even though we earn less per click on items not in the Amazon mass-market bucket. The fit logic is identical regardless of affiliate payout.',
  },
  {
    q: 'My answers feel inconsistent. Will the quiz tell me?',
    a: 'Yes. If you ask for "maximum automation" and also "full manual control", or you say milk drinks but pick a sub-$200 budget that excludes a real steam wand, the result page flags the inconsistency and explains what trade-off you would be making. The quiz never silently picks one side of a contradiction.',
  },
  {
    q: 'Is my progress saved if I leave and come back?',
    a: 'Yes. Your answers are stored in your browser only (localStorage, no server). You can refresh, close the tab, or come back tomorrow and resume from the same question. Use the reset button on the result page to start over.',
  },
];

const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Which espresso machine should I buy? — Interactive quiz',
  description:
    "Seven-question quiz that scores 20+ home espresso machines against your budget, experience, drink preferences, kitchen size, time tolerance, and automation preference. Returns three honest recommendations with caveats when the inputs don't fit any machine in our catalog.",
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  url: 'https://baristapath.com/quiz/which-espresso-machine/',
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Stripeamos las keywords `export` (válidas en ESM, inválidas en un IIFE
// plano). Así el browser ejecuta las mismas funciones que importan los
// tests, pero como declaraciones top-level globales del script inyectado.
const scoringSource = scoringSourceRaw.replace(/^export\s+/gm, '');
---

<Base
  title="Which espresso machine should I buy? — Interactive quiz"
  description="Honest 7-question quiz. Scores 20+ home espresso machines against your budget, experience, drinks, kitchen size, time, and automation preference. Includes caveats when no machine fits."
  canonicalPath="/quiz/which-espresso-machine/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Quiz', url: '/quiz/which-espresso-machine/' },
    { name: 'Which espresso machine should I buy?', url: '/quiz/which-espresso-machine/' },
  ]}
  jsonLd={[webApp, faqLd]}
>
  <h1>Which espresso machine should I buy?</h1>
  <p class="lead">
    Seven questions. No email gate, no spinning wheel of fake personalization. The quiz scores every
    machine in our catalog against your answers and shows you the top three — plus an honest caveat
    if your inputs suggest you should not buy a machine at all right now.
  </p>

  <section class="quiz-wrap" aria-labelledby="quiz-heading">
    <h2 id="quiz-heading" class="visually-hidden">Quiz</h2>

    <div class="quiz-progress" aria-hidden="true">
      <div class="quiz-progress__track">
        <div class="quiz-progress__bar" id="progress-bar" style="width: 14%;"></div>
      </div>
      <p class="quiz-progress__label">
        Question <span id="progress-current">1</span> of <span id="progress-total">7</span>
      </p>
    </div>

    <form id="quiz-form" class="quiz-form" novalidate>
      <fieldset class="quiz-step" data-step="1" data-key="budget">
        <legend class="quiz-step__legend">1. Your total budget (machine + grinder + accessories)</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Budget">
          <label class="quiz-option"><input type="radio" name="budget" value="under-300" /><span>Under $300</span></label>
          <label class="quiz-option"><input type="radio" name="budget" value="300-700" /><span>$300 to $700</span></label>
          <label class="quiz-option"><input type="radio" name="budget" value="700-1500" /><span>$700 to $1,500</span></label>
          <label class="quiz-option"><input type="radio" name="budget" value="1500-3000" /><span>$1,500 to $3,000</span></label>
          <label class="quiz-option"><input type="radio" name="budget" value="over-3000" /><span>Over $3,000</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="2" data-key="experience" hidden>
        <legend class="quiz-step__legend">2. Your experience level with espresso</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Experience level">
          <label class="quiz-option"><input type="radio" name="experience" value="total-beginner" /><span>Total beginner — never pulled a shot</span></label>
          <label class="quiz-option"><input type="radio" name="experience" value="some" /><span>Some experience (Moka pot, AeroPress, pods)</span></label>
          <label class="quiz-option"><input type="radio" name="experience" value="intermediate" /><span>Intermediate — used a semi-auto for a while</span></label>
          <label class="quiz-option"><input type="radio" name="experience" value="advanced" /><span>Advanced — upgrading from a real machine</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="3" data-key="drinks" hidden>
        <legend class="quiz-step__legend">3. What do you drink most often?</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Preferred drinks">
          <label class="quiz-option"><input type="radio" name="drinks" value="espresso" /><span>Straight espresso / americano</span></label>
          <label class="quiz-option"><input type="radio" name="drinks" value="milk" /><span>Milk drinks (latte, cappuccino, flat white)</span></label>
          <label class="quiz-option"><input type="radio" name="drinks" value="mix" /><span>A mix — both, depending on the day</span></label>
          <label class="quiz-option"><input type="radio" name="drinks" value="filter" /><span>Mostly filter / drip coffee</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="4" data-key="volume" hidden>
        <legend class="quiz-step__legend">4. Daily drink volume across the household</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Daily volume">
          <label class="quiz-option"><input type="radio" name="volume" value="1-2" /><span>1 to 2 drinks per day</span></label>
          <label class="quiz-option"><input type="radio" name="volume" value="3-4" /><span>3 to 4 drinks per day</span></label>
          <label class="quiz-option"><input type="radio" name="volume" value="5plus" /><span>5 or more drinks per day</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="5" data-key="space" hidden>
        <legend class="quiz-step__legend">5. Kitchen counter space you can spare</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Kitchen space">
          <label class="quiz-option"><input type="radio" name="space" value="tiny" /><span>Tiny — under 12 inches wide</span></label>
          <label class="quiz-option"><input type="radio" name="space" value="small" /><span>Small — 12 to 18 inches</span></label>
          <label class="quiz-option"><input type="radio" name="space" value="medium" /><span>Medium — half a counter</span></label>
          <label class="quiz-option"><input type="radio" name="space" value="large" /><span>Large — dedicated coffee corner</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="6" data-key="time" hidden>
        <legend class="quiz-step__legend">6. How long are you willing to spend per drink?</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Time tolerance">
          <label class="quiz-option"><input type="radio" name="time" value="1-2min" /><span>1 to 2 minutes — push button, get coffee</span></label>
          <label class="quiz-option"><input type="radio" name="time" value="3-5min" /><span>3 to 5 minutes — workflow is fine</span></label>
          <label class="quiz-option"><input type="radio" name="time" value="5-10min" /><span>5 to 10 minutes — I enjoy the ritual</span></label>
          <label class="quiz-option"><input type="radio" name="time" value="10plus" /><span>10+ minutes — manual pull, all the control</span></label>
        </div>
      </fieldset>

      <fieldset class="quiz-step" data-step="7" data-key="control" hidden>
        <legend class="quiz-step__legend">7. Automation vs control preference</legend>
        <div class="quiz-options" role="radiogroup" aria-label="Automation preference">
          <label class="quiz-option"><input type="radio" name="control" value="max-auto" /><span>Maximum automation — bean to cup, one button</span></label>
          <label class="quiz-option"><input type="radio" name="control" value="some-auto" /><span>Some automation — assisted, but I dose myself</span></label>
          <label class="quiz-option"><input type="radio" name="control" value="full-control" /><span>Full control — semi-auto, I dial everything in</span></label>
          <label class="quiz-option"><input type="radio" name="control" value="pure-manual" /><span>Pure manual — lever, I am the pump</span></label>
        </div>
      </fieldset>

      <div class="quiz-nav">
        <button type="button" id="prev-btn" class="quiz-btn quiz-btn--secondary" disabled>Previous</button>
        <button type="button" id="next-btn" class="quiz-btn" disabled>Next</button>
      </div>
    </form>

    <section
      id="quiz-result"
      class="quiz-result"
      aria-labelledby="result-heading"
      aria-live="polite"
      hidden
    >
      <h2 id="result-heading">Your recommendations</h2>

      <div id="result-caveat" class="quiz-caveat" hidden></div>

      <article id="result-top" class="quiz-rec quiz-rec--top">
        <p class="quiz-rec__label">Top pick</p>
        <h3 class="quiz-rec__name" id="top-name">—</h3>
        <p class="quiz-rec__price" id="top-price">—</p>
        <p class="quiz-rec__why" id="top-why">—</p>
        <div class="quiz-rec__actions" id="top-actions"></div>
      </article>

      <div class="quiz-alternates">
        <article class="quiz-rec" id="result-alt-1">
          <p class="quiz-rec__label">Alternate B</p>
          <h3 class="quiz-rec__name" id="alt1-name">—</h3>
          <p class="quiz-rec__price" id="alt1-price">—</p>
          <p class="quiz-rec__why" id="alt1-why">—</p>
          <div class="quiz-rec__actions" id="alt1-actions"></div>
        </article>
        <article class="quiz-rec" id="result-alt-2">
          <p class="quiz-rec__label">Alternate C</p>
          <h3 class="quiz-rec__name" id="alt2-name">—</h3>
          <p class="quiz-rec__price" id="alt2-price">—</p>
          <p class="quiz-rec__why" id="alt2-why">—</p>
          <div class="quiz-rec__actions" id="alt2-actions"></div>
        </article>
      </div>

      <div id="result-skip" class="quiz-skip" hidden>
        <h3>Categories to skip</h3>
        <ul id="skip-list"></ul>
      </div>

      <div class="quiz-result__actions">
        <button type="button" id="reset-btn" class="quiz-btn quiz-btn--secondary">
          Start over
        </button>
      </div>

      <p class="quiz-result__methodology muted">
        Scoring details and the assumptions behind this quiz are on our
        <a href="/methodology/">methodology page</a>. Disagree with the picks?
        Use the calculator at <a href="/tools/cost-per-cup-calculator/">cost per cup</a>
        to gut-check the payback before buying anything.
      </p>
    </section>
  </section>

  <section class="section" id="how-the-quiz-works">
    <h2>How the quiz works</h2>

    <p>
      Every espresso machine in our <a href="/methodology/">catalog of 20+ machines</a> starts with a
      score of zero. Each of your seven answers either adds points (a good fit on that axis) or
      subtracts points (a poor fit). The top three scorers become your recommendations. The exact
      weights, in plain English:
    </p>

    <ul>
      <li>
        <strong>Budget.</strong> +10 if the machine price fits comfortably. -20 if the machine
        exceeds 1.3× your budget — that's a hard penalty, not a soft preference.
      </li>
      <li>
        <strong>Experience.</strong> Beginners get a boost for beginner-friendly machines (Bambino
        Plus, Magnifica S, Barista Express). Advanced users get a boost for prosumer dual boilers
        and lever machines. Mismatches get small penalties.
      </li>
      <li>
        <strong>Drinks.</strong> Milk drinks favor steam wands and auto frothers. Straight-espresso
        users favor lever machines and prosumer semi-autos. Filter-mostly users get pushed toward
        Moka pot or AeroPress, not an espresso machine.
      </li>
      <li>
        <strong>Volume.</strong> 5+ drinks per day favors dual-boiler machines that can steam and
        brew in parallel. 1 to 2 drinks per day favors smaller, fast-warmup machines.
      </li>
      <li>
        <strong>Kitchen space.</strong> Tiny kitchens get a heavy bonus for compact machines (Dedica,
        Bambino Plus, Robot). Large counters open up the prosumer category.
      </li>
      <li>
        <strong>Time tolerance.</strong> 1 to 2 minute tolerance excludes manual lever machines and
        slow-warmup prosumers. 10+ minute tolerance favors them.
      </li>
      <li>
        <strong>Automation.</strong> "Max auto" pushes super-automatics to the top. "Pure manual"
        pushes lever machines to the top. The middle two answers create a wider competitive field.
      </li>
    </ul>

    <h3>When the quiz refuses to recommend a machine</h3>

    <p>
      If your top candidate scores below zero, or if your budget falls under the realistic
      threshold for the drinks you said you want, the result page shows a caveat instead of pushing
      a sale. Common cases:
    </p>

    <ul>
      <li>
        <strong>Budget under $200 + milk drinks.</strong> A real steam wand starts around the
        Casabrews / Dedica price point, and even those compromise. Below that, you are buying a
        toy. We will tell you so.
      </li>
      <li>
        <strong>Budget under $200 + "real espresso".</strong> No 9-bar machine exists at that
        price. The Flair Classic Signature is the only honest entry — but it is a manual lever, not
        a push-button machine. If you want push-button espresso under $200, you do not get it. Buy
        a Moka pot or AeroPress while you save.
      </li>
      <li>
        <strong>Maximum automation + pure manual.</strong> Pick one. The quiz will ask you to
        reconsider rather than splitting the difference badly.
      </li>
      <li>
        <strong>Beginner + $3,000+.</strong> Possible, but the ROI on the difference between a $700
        Bambino+grinder and a $3,000 Linea Mini is mostly emotional. We will say so and let you
        decide.
      </li>
    </ul>
  </section>

  <section class="related-content">
    <h2>If you came here from a guide</h2>
    <ul>
      <li class="related-link related-link--best">
        <a href="/best/best-espresso-machine-under-500/">Best espresso machines under $500</a>
      </li>
      <li class="related-link related-link--best">
        <a href="/best/best-espresso-machine-for-beginners/">Best espresso machines for beginners</a>
      </li>
      <li class="related-link related-link--best">
        <a href="/best/best-grinder-under-200/">Best grinders under $200</a>
      </li>
      <li class="related-link related-link--tool">
        <a href="/tools/cost-per-cup-calculator/">Cost per cup calculator</a>
      </li>
    </ul>
  </section>

  <section class="faq" id="faq">
    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  {/* Catálogo serializado en JSON al build — lo lee el script inline. */}
  <script
    type="application/json"
    id="quiz-catalog"
    set:html={JSON.stringify(catalogWithReviews)}
  ></script>
</Base>

<script is:inline set:html={`
  // SCORING — inyectado desde src/lib/quiz-scoring.js al build time
  // (un solo source of truth con los tests). Las funciones quedan en
  // scope global del documento porque son declaraciones top-level.
  ${scoringSource}
`}></script>

<script is:inline>
  // Plumbing del UI: progreso, persistencia, render. Usa pickRecommendations
  // del módulo de scoring inyectado arriba (window-scope global).
  (function(){'use strict';
    var KEY='bp_quiz_v1',TAG='baristapath79-20',
        STEPS=['budget','experience','drinks','volume','space','time','control'],N=STEPS.length;
    var cat=[];try{cat=JSON.parse(document.getElementById('quiz-catalog').textContent||'[]');}catch(e){}
    var s={current:0,answers:{}};
    try{var r=localStorage.getItem(KEY);if(r){var p=JSON.parse(r);if(p&&p.answers){s.answers=p.answers;s.current=Math.min(p.current||0,N-1);}}}catch(e){}
    var $=function(id){return document.getElementById(id);};
    var form=$('quiz-form'),pb=$('prev-btn'),nb=$('next-btn'),rb=$('reset-btn'),
        res=$('quiz-result'),bar=$('progress-bar'),pcur=$('progress-current');

    function save(){try{localStorage.setItem(KEY,JSON.stringify(s));}catch(e){}}
    function show(i){
      var steps=form.querySelectorAll('.quiz-step');
      for(var j=0;j<steps.length;j++)steps[j].hidden=j!==i;
      var k=STEPS[i],sv=s.answers[k];
      if(sv){var inp=form.querySelector('input[name="'+k+'"][value="'+sv+'"]');if(inp)inp.checked=true;}
      var fr=steps[i].querySelector('input[type="radio"]');if(fr)fr.focus({preventScroll:true});
      nav();bar.style.width=Math.round((i+1)/N*100)+'%';pcur.textContent=String(i+1);
    }
    function nav(){
      pb.disabled=s.current===0;
      nb.disabled=!s.answers[STEPS[s.current]];
      nb.textContent=s.current===N-1?'See my recommendations':'Next';
    }
    function next(){
      if(!s.answers[STEPS[s.current]])return;
      if(s.current===N-1){render();return;}
      s.current++;save();show(s.current);
    }
    function prev(){if(s.current===0)return;s.current--;save();show(s.current);}
    function reset(){
      try{localStorage.removeItem(KEY);}catch(e){}
      s={current:0,answers:{}};
      var rs=form.querySelectorAll('input[type="radio"]');for(var i=0;i<rs.length;i++)rs[i].checked=false;
      res.hidden=true;form.hidden=false;
      var pr=document.querySelector('.quiz-progress');if(pr)pr.style.display='';
      show(0);
    }

    // SCORING vive en src/lib/quiz-scoring.js (inyectado en el script anterior).
    // Acá sólo usamos las funciones expuestas como globals:
    //   scoreProduct, buildCaveats, buildSkipCategories, pickRecommendations.

    function why1(p,r){
      if(!r.length)return 'Fits your overall profile better than the alternatives in our catalog.';
      var t=r.slice(0,2).join('; ');return t.charAt(0).toUpperCase()+t.slice(1)+'.';
    }

    function priceLbl(p){return (p.type==='brewer'?'Brewer · ':'')+'$'+p.price;}

    function actions(c,p){
      c.innerHTML='';
      var wrap=document.createElement('span');wrap.className='affiliate-button-wrap affiliate-button-wrap--primary';
      var a=document.createElement('a');
      a.className='affiliate-button affiliate-button--primary';
      a.href='https://amazon.com/dp/'+p.asin+'?tag='+TAG;
      a.rel='sponsored nofollow noopener';a.target='_blank';
      a.setAttribute('aria-label','Check price on Amazon: '+p.name+' (opens Amazon in a new tab)');
      a.textContent='Check price on Amazon';
      var ic=document.createElement('span');ic.className='affiliate-button__icon';ic.setAttribute('aria-hidden','true');ic.textContent=' ↗';
      a.appendChild(ic);wrap.appendChild(a);
      var d=document.createElement('span');d.className='affiliate-button__disclosure';
      d.innerHTML='Affiliate link &middot; <a href="/about/#disclosure">disclosure</a>';
      wrap.appendChild(d);c.appendChild(wrap);
      var lk=document.createElement('p');lk.className='quiz-rec__links';
      var sp=document.createElement('a');sp.href='/products/'+p.asin+'/';sp.textContent='Full specs and notes';lk.appendChild(sp);
      if(p.reviewSlug){lk.appendChild(document.createTextNode(' · '));
        var rv=document.createElement('a');rv.href='/review/'+p.reviewSlug+'/';rv.textContent='In-depth review';lk.appendChild(rv);}
      c.appendChild(lk);
    }

    function render(){
      var a=s.answers;
      // pickRecommendations viene del módulo inyectado: corre scoring + ranking
      // + caveats + skip categories de una sola llamada. Mismo pipeline que
      // los tests de test/quiz.spec.js.
      var rec=pickRecommendations(a,cat);
      var top=rec.topPick,alts=rec.alternates||[],a1=alts[0],a2=alts[1];

      var cv=rec.caveats||[],ce=$('result-caveat');
      if(cv.length){ce.innerHTML='<h3>Honest caveat</h3>'+cv.map(function(c){return '<p>'+c+'</p>';}).join('');ce.hidden=false;}
      else{ce.hidden=true;ce.innerHTML='';}

      if(top&&top.product){
        $('top-name').textContent=top.product.name;$('top-price').textContent=priceLbl(top.product);
        $('top-why').textContent=why1(top.product,top.reasons);actions($('top-actions'),top.product);
      }
      function alt(x,pre){
        if(!x||!x.product)return;
        $(pre+'-name').textContent=x.product.name;$(pre+'-price').textContent=priceLbl(x.product);
        $(pre+'-why').textContent=x.reasons.length?'Why this instead: '+x.reasons[0]+'.':'Why this instead: closest fit on remaining axes.';
        actions($(pre+'-actions'),x.product);
      }
      alt(a1,'alt1');alt(a2,'alt2');

      var sk=rec.skipCategories||[],sb=$('result-skip'),sl=$('skip-list');
      if(sk.length){sl.innerHTML='';for(var i=0;i<sk.length;i++){var li=document.createElement('li');li.textContent=sk[i];sl.appendChild(li);}sb.hidden=false;}
      else sb.hidden=true;

      form.hidden=true;
      var pr=document.querySelector('.quiz-progress');if(pr)pr.style.display='none';
      res.hidden=false;res.scrollIntoView({behavior:'smooth',block:'start'});
    }

    function onChange(e){
      var t=e.target;if(!t||t.tagName!=='INPUT'||t.type!=='radio')return;
      s.answers[t.name]=t.value;save();nav();
    }
    function onKey(e){
      if(e.key==='Enter'&&!nb.disabled&&document.activeElement&&document.activeElement.tagName!=='BUTTON'){
        e.preventDefault();next();
      }
    }

    function init(){
      show(s.current);
      form.addEventListener('change',onChange);
      form.addEventListener('keydown',onKey);
      nb.addEventListener('click',next);
      pb.addEventListener('click',prev);
      rb.addEventListener('click',reset);
      if(STEPS.every(function(k){return !!s.answers[k];})&&s.current===N-1)nav();
    }

    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);
    else init();
  })();
</script>

