---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { comparePages, type ComparePage } from '../../data/compare-pages';
import { relatedForCompare } from '../../lib/related-content';
import AffiliateButton from '../../components/AffiliateButton.astro';
import Byline from '../../components/Byline.astro';

type Product = CollectionEntry<'products'>;

export async function getStaticPaths() {
  const { comparePages: comparisons } = await import('../../data/compare-pages');
  const all = await getCollection('products');
  const byAsin = new Map(all.map((p) => [p.data.asin, p]));

  return comparisons
    .map((comp) => {
      const a = byAsin.get(comp.asinA);
      const b = byAsin.get(comp.asinB);
      if (!a || !b) {
        // eslint-disable-next-line no-console
        console.warn(`Compare page ${comp.slug}: missing ASIN ${comp.asinA} or ${comp.asinB}`);
        return null;
      }
      return {
        params: { slug: comp.slug },
        props: { comp, a, b },
      };
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null);
}

interface Props {
  comp: ComparePage;
  a: Product;
  b: Product;
}

const { comp, a, b } = Astro.props as Props;
const related = await relatedForCompare(comp.slug);

// updatedAt: max(updated_at) de los dos productos comparados. Refleja la
// última vez que cualquiera de los specs se tocó.
const updatedAt = new Date(
  Math.max(a.data.updated_at.getTime(), b.data.updated_at.getTime())
);

const title = `${a.data.name} vs ${b.data.name}: Side-by-Side Comparison`;
const description = `${a.data.name} versus ${b.data.name}: specs, pros, cons, pricing, and a clear recommendation by use case.`;

// ---------- Spec row construction ----------
//
// La tabla original listaba TODAS las features unidas en orden alfabético.
// Patrón recomendado (research/design-benchmark.md, Batch C) es mostrar
// primero las filas donde A y B difieren ("differentiators") y colapsar
// las comunes bajo <details>. Honest framing: si comparten casi todo,
// se lo decimos al lector en vez de inflar diferencias falsas.

type FeatureValue = string | number | boolean;

interface SpecRow {
  key: string;
  label: string;
  valueA: FeatureValue | undefined;
  valueB: FeatureValue | undefined;
}

// Heurística de importancia: claves listadas primero pesan más para el
// orden de differentiators. Match es por substring sobre la key normalizada
// (lowercase, underscores intactos) para que matches parciales tipo
// "burr_size_mm" cuenten para "burr". Si la comparación es de productos
// fuera del dominio espresso (e.g. brewers), las keys simplemente no
// matchean nada y caemos al sort alfabético del fallback.
const IMPORTANCE_HINTS = [
  'price', // injected como pseudo-row, ya rankea primero
  'boiler',
  'group_head',
  'group',
  'pid',
  'bar_pressure',
  'pressure',
  'wattage',
  'watt',
  'power',
  'steam',
  'milk',
  'grinder',
  'built_in',
  'burr',
  'capacity',
  'water_tank',
  'dimensions',
  'weight',
  'material',
  'warranty',
];

function importanceScore(key: string): number {
  const k = key.toLowerCase();
  for (let i = 0; i < IMPORTANCE_HINTS.length; i++) {
    if (k.includes(IMPORTANCE_HINTS[i])) {
      // Lower score = higher priority. Spread so ties go alphabetical.
      return i;
    }
  }
  return IMPORTANCE_HINTS.length + 100;
}

function prettifyLabel(key: string): string {
  return key.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

function formatValue(v: FeatureValue | undefined): string {
  if (v === undefined || v === null) return '—';
  if (typeof v === 'boolean') return v ? 'Yes' : 'No';
  return String(v);
}

// Una fila es "differentiator" si:
// - Ausente en uno de los dos productos, O
// - Ambos presentes pero con valores distintos (comparación estricta tras
//   normalizar a string, sin redondear: 100W vs 110W cuenta como diferencia).
// - Tipos distintos (string vs boolean) también: differentiator.
function isDifferentiator(row: SpecRow): boolean {
  const aPresent = row.valueA !== undefined;
  const bPresent = row.valueB !== undefined;
  if (!aPresent || !bPresent) return true;
  if (typeof row.valueA !== typeof row.valueB) return true;
  return String(row.valueA) !== String(row.valueB);
}

// Filas base: price + price_tier + brand + union(feature keys).
// Brand lo tratamos como spec más para que aparezca en common si coincide.
const featureKeys = new Set<string>([
  ...Object.keys(a.data.features),
  ...Object.keys(b.data.features),
]);

const baseRows: SpecRow[] = [
  {
    key: '_price',
    label: 'Price (USD)',
    valueA: `$${a.data.price}`,
    valueB: `$${b.data.price}`,
  },
  {
    key: '_price_tier',
    label: 'Price tier',
    valueA: a.data.price_tier,
    valueB: b.data.price_tier,
  },
  {
    key: '_brand',
    label: 'Brand',
    valueA: a.data.brand,
    valueB: b.data.brand,
  },
  ...Array.from(featureKeys).map<SpecRow>((key) => ({
    key,
    label: prettifyLabel(key),
    valueA: a.data.features[key],
    valueB: b.data.features[key],
  })),
];

const differentiatorRows = baseRows
  .filter(isDifferentiator)
  .sort((rowX, rowY) => {
    // Price siempre primero (si difiere).
    if (rowX.key === '_price') return -1;
    if (rowY.key === '_price') return 1;
    const sx = importanceScore(rowX.key);
    const sy = importanceScore(rowY.key);
    if (sx !== sy) return sx - sy;
    // Fallback alfabético por label cuando importance no aplica.
    return rowX.label.localeCompare(rowY.label);
  });

const commonRows = baseRows
  .filter((row) => !isDifferentiator(row))
  .sort((rowX, rowY) => rowX.label.localeCompare(rowY.label));

// Si differentiators <3, marcamos el flag para mostrar el aviso honesto.
const fewDifferentiators = differentiatorRows.length < 3;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/' },
  { name: `${a.data.name} vs ${b.data.name}`, url: `/compare/${comp.slug}/` },
];

// JSON-LD: WebPage with mainEntity describing both compared products.
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [a, b].map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Product',
        name: p.data.name,
        brand: { '@type': 'Brand', name: p.data.brand },
      },
    })),
  },
};

const faq = [
  {
    q: `Is the ${a.data.name} better than the ${b.data.name}?`,
    a: `Neither is universally better — they target different users. The ${a.data.name} is best for ${a.data.best_for.slice(0, 2).join(' and ')}. The ${b.data.name} is best for ${b.data.best_for.slice(0, 2).join(' and ')}.`,
  },
  {
    q: `What's the price difference?`,
    a: `The ${a.data.name} retails around $${a.data.price}; the ${b.data.name} around $${b.data.price}. Price difference: $${Math.abs(a.data.price - b.data.price)}.`,
  },
  {
    q: `Which one is better for milk drinks?`,
    a: `Look at the steam-related features in the spec table. Tags help too — products with 'milk-drinks' or 'dual-boiler' tags handle milk better. ${a.data.name} tags: ${a.data.tags.join(', ')}. ${b.data.name} tags: ${b.data.tags.join(', ')}.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// Build-time log para calcular promedio de differentiators y detectar
// páginas con <3 diffs. Lo lee el operador en el output del build.
// eslint-disable-next-line no-console
console.log(
  `[compare-stats] slug=${comp.slug} diff=${differentiatorRows.length} common=${commonRows.length}`
);

void comparePages;
---
<Base
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={[pageSchema, faqSchema]}
  updatedAt={updatedAt}
>
  <h1>{a.data.name} vs {b.data.name}</h1>
  <Byline updatedAt={updatedAt} />
  <p class="lead">{comp.intro}</p>

  <section class="section">
    <h2>Quick verdict</h2>
    <div class="pros-cons">
      <div>
        <h3><a href={`/products/${a.data.asin}/`}>{a.data.name}</a></h3>
        <p class="meta muted">${a.data.price} &middot; {a.data.price_tier} tier</p>
        <p><strong>Best for:</strong> {a.data.best_for.slice(0, 3).join(', ')}</p>
        <AffiliateButton asin={a.data.asin} productName={a.data.name} />
      </div>
      <div>
        <h3><a href={`/products/${b.data.asin}/`}>{b.data.name}</a></h3>
        <p class="meta muted">${b.data.price} &middot; {b.data.price_tier} tier</p>
        <p><strong>Best for:</strong> {b.data.best_for.slice(0, 3).join(', ')}</p>
        <AffiliateButton asin={b.data.asin} productName={b.data.name} />
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Key differences</h2>
    {fewDifferentiators ? (
      <p class="compare-note">
        These products share most specifications — see the verdict above for
        the meaningful differences.
      </p>
    ) : (
      <p class="muted compare-subtle">
        Specs where the two products diverge. Full spec list is below.
      </p>
    )}

    {differentiatorRows.length > 0 && (
      <div class="compare-table-wrap">
        <table class="specs-table compare-table compare-table--differentiators">
          <thead>
            <tr>
              <th scope="col">Spec</th>
              <th scope="col">{a.data.name}</th>
              <th scope="col">{b.data.name}</th>
            </tr>
          </thead>
          <tbody>
            {differentiatorRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{formatValue(row.valueA)}</td>
                <td>{formatValue(row.valueB)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {commonRows.length > 0 && (
      <details class="compare-common-details">
        <summary>
          Show full specs <span class="compare-common-count">({commonRows.length} shared {commonRows.length === 1 ? 'spec' : 'specs'})</span>
        </summary>
        <div class="compare-table-wrap">
          <table class="specs-table compare-table compare-table--common">
            <thead>
              <tr>
                <th scope="col">Spec</th>
                <th scope="col">{a.data.name}</th>
                <th scope="col">{b.data.name}</th>
              </tr>
            </thead>
            <tbody>
              {commonRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{formatValue(row.valueA)}</td>
                  <td>{formatValue(row.valueB)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    )}
  </section>

  <section class="section pros-cons">
    <div>
      <h3>{a.data.name}</h3>
      <div class="pros">
        <h4>Pros</h4>
        <ul>{a.data.pros.map((p: string) => <li>{p}</li>)}</ul>
      </div>
      <div class="cons">
        <h4>Cons</h4>
        <ul>{a.data.cons.map((p: string) => <li>{p}</li>)}</ul>
      </div>
    </div>
    <div>
      <h3>{b.data.name}</h3>
      <div class="pros">
        <h4>Pros</h4>
        <ul>{b.data.pros.map((p: string) => <li>{p}</li>)}</ul>
      </div>
      <div class="cons">
        <h4>Cons</h4>
        <ul>{b.data.cons.map((p: string) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section faq">
    <h2>Frequently Asked Questions</h2>
    {faq.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>

  {related.length > 0 && (
    <section class="section related-content" aria-labelledby="related-heading">
      <h2 id="related-heading">Related content</h2>
      <ul>
        {related.map((link) => (
          <li class={`related-link related-link--${link.kind}`}>
            <a href={link.href}>{link.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
