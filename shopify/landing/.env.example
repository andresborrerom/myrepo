# Supabase — credenciales del proyecto donde vive la tabla `waitlist`.
# Crear proyecto en https://supabase.com (plan free alcanza).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — webhook a Slack / Telegram cuando alguien se apunta a la waitlist.
# Si está vacío, no se notifica.
NOTIFY_WEBHOOK_URL=
